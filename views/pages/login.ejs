<div id="app">
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="paper w-full max-w-md p-7 sm:p-10">
      <p class="section-kicker text-center mb-2">WELCOME BACK</p><h1 class="display text-3xl font-bold text-rose-primary text-center mb-7">花漾生活</h1>

      <!-- Tabs -->
      <div class="flex mb-7 border border-[#b9c0b8] overflow-hidden">
        <button
          @click="activeTab = 'login'; errors = {}"
          class="flex-1 py-2 text-sm font-medium transition-colors"
          :class="activeTab === 'login' ? 'bg-rose-primary text-white' : 'text-text-secondary hover:bg-[#f4f2ec]'"
        >
          登入
        </button>
        <button
          @click="activeTab = 'register'; errors = {}"
          class="flex-1 py-2 text-sm font-medium transition-colors"
          :class="activeTab === 'register' ? 'bg-rose-primary text-white' : 'text-text-secondary hover:bg-[#f4f2ec]'"
        >
          註冊
        </button>
      </div>

      <!-- Login Form -->
      <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="space-y-4">
        <div>
          <label class="block text-sm text-text-secondary mb-1">Email</label>
          <input
            v-model="loginForm.email"
            type="email"
            placeholder="請輸入 Email"
            class="field"
            :class="{ 'border-red-400': errors.email }"
          />
          <p v-if="errors.email" class="text-red-500 text-xs mt-1">{{ errors.email }}</p>
        </div>

        <div>
          <label class="block text-sm text-text-secondary mb-1">密碼</label>
          <input
            v-model="loginForm.password"
            type="password"
            placeholder="請輸入密碼"
            class="field"
            :class="{ 'border-red-400': errors.password }"
          />
          <p v-if="errors.password" class="text-red-500 text-xs mt-1">{{ errors.password }}</p>
        </div>

        <button
          type="submit"
          :disabled="submitting"
          class="button-primary w-full disabled:opacity-50"
        >
          {{ submitting ? '登入中...' : '登入' }}
        </button>
      </form>

      <!-- Register Form -->
      <form v-else @submit.prevent="handleRegister" class="space-y-4">
        <div>
          <label class="block text-sm text-text-secondary mb-1">姓名</label>
          <input
            v-model="registerForm.name"
            type="text"
            placeholder="請輸入姓名"
            class="field"
            :class="{ 'border-red-400': errors.name }"
          />
          <p v-if="errors.name" class="text-red-500 text-xs mt-1">{{ errors.name }}</p>
        </div>

        <div>
          <label class="block text-sm text-text-secondary mb-1">Email</label>
          <input
            v-model="registerForm.email"
            type="email"
            placeholder="請輸入 Email"
            class="field"
            :class="{ 'border-red-400': errors.email }"
          />
          <p v-if="errors.email" class="text-red-500 text-xs mt-1">{{ errors.email }}</p>
        </div>

        <div>
          <label class="block text-sm text-text-secondary mb-1">密碼</label>
          <input
            v-model="registerForm.password"
            type="password"
            placeholder="至少 6 個字元"
            class="field"
            :class="{ 'border-red-400': errors.password }"
          />
          <p v-if="errors.password" class="text-red-500 text-xs mt-1">{{ errors.password }}</p>
        </div>

        <button
          type="submit"
          :disabled="submitting"
          class="button-primary w-full disabled:opacity-50"
        >
          {{ submitting ? '註冊中...' : '註冊' }}
        </button>
      </form>
    </div>
  </div>
</div>
