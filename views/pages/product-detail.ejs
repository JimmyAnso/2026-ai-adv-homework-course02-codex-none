<div id="app" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-16">
    <div class="text-5xl mb-4">&#127804;</div>
    <h2 class="text-xl font-medium text-text-primary mb-2">找不到此商品</h2>
    <a href="/" class="text-rose-primary hover:text-rose-dark text-sm">回到首頁</a>
  </div>

  <div v-else-if="product" class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:gap-14">
    <!-- Left: Image -->
    <div>
      <div class="detail-photo">
        <img
          :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=600'"
          :alt="product.name"
          class="w-full aspect-square object-cover"
        />
      </div>
    </div>

    <!-- Right: Info -->
    <div class="detail-info">
      <p class="section-kicker mb-3">花藝師手作・當令花材</p>
      <h1 class="display text-3xl font-bold text-text-primary mb-3 md:text-4xl">
        {{ product.name }}
      </h1>
      <div class="detail-price mb-5"><p class="text-2xl text-rose-primary font-bold">NT$ {{ product.price.toLocaleString() }}</p><span class="text-xs text-text-muted">含花藝師包裝</span></div>

      <div class="mb-6">
        <span v-if="product.stock > 0" class="detail-stock"><span aria-hidden="true">✓</span> 可訂購・現做配送</span>
        <span v-else class="detail-stock !bg-[#f3e4dd] !text-rose-primary">本日已售完</span>
      </div>

      <p class="text-text-secondary leading-relaxed mb-6">{{ product.description }}</p>

      <!-- Quantity Selector -->
      <div class="flex items-center gap-4 mb-7 border-y border-[#d8dad3] py-5">
        <span class="text-sm text-text-secondary">數量</span>
        <div class="flex items-center border border-[#b9c0b8] overflow-hidden">
          <button
            @click="decrease"
            aria-label="減少數量"
            class="w-10 h-10 flex items-center justify-center hover:bg-[#f4f2ec] text-text-secondary transition-colors"
          >
            -
          </button>
          <span class="w-12 h-10 flex items-center justify-center text-sm border-x border-[#b9c0b8]">
            {{ quantity }}
          </span>
          <button
            @click="increase"
            aria-label="增加數量"
            class="w-10 h-10 flex items-center justify-center hover:bg-[#f4f2ec] text-text-secondary transition-colors"
          >
            +
          </button>
        </div>
      </div>

      <button
        @click="addToCart"
        :disabled="adding || product.stock <= 0"
        class="button-primary w-full disabled:opacity-50"
      >
        {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
      </button>

      <!-- Purchase Notes -->
      <div class="purchase-note mt-6 p-5">
        <h3 class="font-medium text-text-primary mb-2 text-sm">購買須知</h3>
        <ul class="text-text-muted text-xs space-y-1.5">
          <li>花材依季節供應，實際花束可能略有差異</li>
          <li>台北市區可享當日配送服務</li>
          <li>消費滿 NT$ 500 享免運優惠</li>
        </ul>
      </div>
    </div>
  </div>
</div>
