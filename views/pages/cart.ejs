<div id="app">
  <p class="section-kicker mb-2">你的花籃</p><h1 class="display text-3xl font-bold text-text-primary mb-8">準備送出的心意</h1>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="text-center py-12">
    <div class="text-4xl mb-3">&#128722;</div>
    <p class="text-text-secondary mb-1">購物車是空的</p>
    <p class="text-text-muted text-sm mb-4">快去挑選喜歡的花束吧！</p>
    <a href="/" class="button-primary mt-2">去逛逛</a>
  </div>

  <template v-else>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div>
        <div v-if="total < 500" class="border-l-2 border-apricot bg-[#fffefa] p-3 mb-5 text-sm text-rose-primary">
          再選 NT$ {{ (500 - total).toLocaleString() }} 就能享有免運配送
          <div class="mt-2 h-1.5 overflow-hidden bg-[#eeeae3]"><span class="block h-full bg-apricot" :style="{ width: Math.min(total / 500 * 100, 100) + '%' }"></span></div>
        </div>
        <div v-else class="border-l-2 border-sage bg-[#fffefa] p-3 mb-5 text-sm text-sage">
          已達免運門檻，這筆訂單享有免運配送
        </div>

        <div class="paper overflow-hidden">
          <div
            v-for="item in items"
            :key="item.id"
            class="cart-line"
          >
            <img
              :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=160'"
              :alt="item.product.name"
              class="cart-line-image"
            />
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-text-primary text-sm">{{ item.product.name }}</h3>
              <p class="mt-1 text-rose-primary text-sm">NT$ {{ item.product.price.toLocaleString() }}</p>
            </div>

            <div class="flex items-center border border-[#b9c0b8] overflow-hidden">
              <button
                @click="updateQuantity(item.id, item.quantity - 1)"
                :disabled="item.quantity <= 1"
                :aria-label="'減少 ' + item.product.name + ' 數量'"
                class="w-8 h-8 flex items-center justify-center hover:bg-gray-50 text-text-secondary text-sm disabled:opacity-40"
              >−</button>
              <span class="w-8 h-8 flex items-center justify-center text-sm border-x border-gray-200">{{ item.quantity }}</span>
              <button
                @click="updateQuantity(item.id, item.quantity + 1)"
                :disabled="item.quantity >= item.product.stock"
                :aria-label="'增加 ' + item.product.name + ' 數量'"
                class="w-8 h-8 flex items-center justify-center hover:bg-gray-50 text-text-secondary text-sm disabled:opacity-40 disabled:cursor-not-allowed"
              >＋</button>
            </div>

            <p class="text-text-primary font-bold text-sm w-24 text-right">
              NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
            </p>

            <button @click="confirmDelete(item.id)" :aria-label="'移除 ' + item.product.name" class="text-text-muted hover:text-red-500 transition-colors text-sm ml-1">移除</button>
          </div>
        </div>
        <a href="/" class="cart-continue-link">← 繼續挑選花束</a>
      </div>

      <aside class="paper p-5 sm:p-6 lg:sticky lg:top-32">
        <h2 class="display mb-5 text-xl font-bold text-text-primary">訂單摘要</h2>
        <div class="flex justify-between items-center mb-3 text-sm">
          <span class="text-text-secondary">商品小計</span>
          <span class="text-text-primary">NT$ {{ total.toLocaleString() }}</span>
        </div>
        <div class="flex justify-between items-center mb-5 text-sm">
          <span class="text-text-secondary">運費</span>
          <span class="text-text-primary">{{ total >= 500 ? '免運' : 'NT$ 150' }}</span>
        </div>
        <div class="border-t border-[#d8dad3] pt-4 flex justify-between items-center">
          <span class="font-bold text-text-primary">應付總額</span>
          <span class="font-bold text-xl text-rose-primary">NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span>
        </div>
        <button @click="goCheckout" class="button-primary w-full mt-5">前往結帳</button>
        <p class="mt-3 text-center text-xs text-text-muted">結帳時填寫收件與配送資料</p>
      </aside>
    </div>
  </template>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" @click="confirmVisible = false"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-lg font-semibold text-text-primary mb-2">確認移除</h3>
      <p class="text-text-secondary text-sm mb-6">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-4 py-2 text-sm rounded-lg border border-gray-200 text-text-secondary hover:bg-gray-50">取消</button>
        <button @click="handleDelete" class="px-4 py-2 text-sm rounded-lg bg-red-500 text-white hover:bg-red-600">確認移除</button>
      </div>
    </div>
  </div>
</div>
